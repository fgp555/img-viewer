<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <StartupObject>IMGViewer.ProbeProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/>
    <Compile Include="../../IMGViewer/DesktopSnapshot.cs" Link="Shared/DesktopSnapshot.cs"/>
    <Compile Include="../../IMGViewer/CaptureSelectionVisual.cs" Link="Shared/CaptureSelectionVisual.cs"/>
    <Compile Include="../../IMGViewer/CaptureSelectionMetrics.cs" Link="Shared/CaptureSelectionMetrics.cs"/>
    <Compile Include="../../IMGViewer/ScreenCaptureWindow.xaml.cs" Link="Shared/ScreenCaptureWindow.xaml.cs"/>
    <Page Include="../../IMGViewer/ScreenCaptureWindow.xaml" Link="Shared/ScreenCaptureWindow.xaml"/>
  </ItemGroup>
</Project>
