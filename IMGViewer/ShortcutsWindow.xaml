<Window x:Class="IMGViewer.ShortcutsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Acciones y atajos" Width="1040" Height="760" MinWidth="360" MinHeight="320" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent" Foreground="#EEEEEE" SizeChanged="Window_SizeChanged">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DialogTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<Style x:Key="ShortcutRow" TargetType="Button"><Setter Property="Foreground" Value="#DDDDDD"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303334"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3A3D3E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8A969E"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary></Window.Resources><Window.Style><StaticResource ResourceKey="DialogWindow"/></Window.Style>
<DockPanel><StackPanel DockPanel.Dock="Top" Margin="20,14,20,12"><TextBlock Text="Atajos de teclado" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Consulta los atajos o pulsa una acción para ejecutarla." Foreground="#A5A9AB" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Separator/><Grid><ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14"/><Button Content="Cerrar" IsCancel="True" Click="Close_Click" HorizontalAlignment="Right" Margin="16,10,22,12"/></Grid></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="Sections" Margin="14,0,14,14"/></ScrollViewer></DockPanel></Window>
