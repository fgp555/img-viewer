<Window x:Class="IMGViewer.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recortar y enderezar" Width="820" Height="650" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="#141820" Foreground="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Enderezar" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button DockPanel.Dock="Right" Content="Restablecer" Padding="10,4" Click="Reset_Click" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=Angle, StringFormat={}{0:0.0}°}"
                           Width="62" TextAlignment="Center" VerticalAlignment="Center" />
                <Slider x:Name="Angle" Minimum="-15" Maximum="15" TickFrequency="0.1"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        AutomationProperties.Name="Ángulo para enderezar"
                        ValueChanged="Angle_ValueChanged" />
            </DockPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancelar" IsCancel="True" Padding="14,5" Margin="0,0,8,0" />
                <Button Content="Aplicar" IsDefault="True" Padding="14,5" Click="Apply_Click" />
            </StackPanel>
        </Grid>
        <Viewbox Stretch="Uniform">
            <Canvas x:Name="Preview" Background="#353535" ClipToBounds="True"
                    MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                    MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                    LostMouseCapture="Preview_LostMouseCapture">
                <Image x:Name="PreviewImage" Stretch="Fill" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="PreviewRotation" />
                    </Image.RenderTransform>
                </Image>
                <Path x:Name="Shade" Fill="#99000000" IsHitTestVisible="False" />
                <Path x:Name="CropLines" Stroke="White" StrokeThickness="1"
                      IsHitTestVisible="False" />
                <Path x:Name="Handles" Fill="White" Stroke="#303030" StrokeThickness="1"
                      IsHitTestVisible="False" />
            </Canvas>
        </Viewbox>
    </DockPanel>
</Window>
