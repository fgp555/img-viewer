<Window x:Class="IMGViewer.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Title="Capturar pantalla" Background="Black"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="Surface" ClipToBounds="True" SizeChanged="Surface_SizeChanged">
        <Image x:Name="FrozenDesktop" Stretch="Fill" IsHitTestVisible="False" />
        <Grid x:Name="SelectionSurface" Focusable="True" Background="Transparent" Cursor="Cross"
              MouseLeftButtonDown="Selection_MouseLeftButtonDown" MouseMove="Selection_MouseMove"
              MouseWheel="Selection_MouseWheel" MouseLeave="Selection_MouseLeave"
              MouseLeftButtonUp="Selection_MouseLeftButtonUp" LostMouseCapture="Selection_LostMouseCapture">
            <Path x:Name="Dimmer" Fill="#99000000" IsHitTestVisible="False" />
            <Path x:Name="Outline" Stroke="#FFFFC247" StrokeThickness="1.5" StrokeDashArray="5,3" IsHitTestVisible="False" />
            <Line x:Name="HorizontalGuide" Stroke="#FFFFC247" StrokeThickness="1" Opacity="0.8" IsHitTestVisible="False" Visibility="Collapsed" />
            <Line x:Name="VerticalGuide" Stroke="#FFFFC247" StrokeThickness="1" Opacity="0.8" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>
        <Canvas>
            <Button x:Name="Toolbar" Background="#F0181818" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand" Click="CaptureMonitor_Click" SizeChanged="Surface_SizeChanged" ToolTip="Capturar el monitor completo · Esc cancela" AutomationProperties.Name="Capturar pantalla completa">
                <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#333333"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="Background" Value="#333333"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Pantalla completa" FontSize="11" VerticalAlignment="Center"/><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE740;" FontSize="16" Foreground="#FFC247" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Button>
        </Canvas>
    </Grid>
</Window>
