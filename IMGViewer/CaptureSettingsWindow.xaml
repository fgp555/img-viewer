<Window x:Class="IMGViewer.CaptureSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:IMGViewer" Title="Configuración" Width="920" Height="680" MinWidth="720" MinHeight="440" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="Transparent" Foreground="#EEEEEE">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DialogTheme.xaml"/></ResourceDictionary.MergedDictionaries>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#232323"/><Setter Property="BorderBrush" Value="#383838"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,16,0,20"/></Style>
<Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,20,0"/><Border x:Name="Track" Grid.Column="1" Background="#555555" Width="36" Height="20" CornerRadius="10" VerticalAlignment="Center"><Ellipse x:Name="Thumb" Fill="#EEEEEE" Width="14" Height="14" HorizontalAlignment="Left" Margin="3"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#087CCB"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#EEEEEE"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary></Window.Resources><Window.Style><StaticResource ResourceKey="DialogWindow"/></Window.Style>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#1B1D1E" BorderBrush="#353535" BorderThickness="0,0,1,0"><DockPanel Margin="14,16">
<TextBlock DockPanel.Dock="Top" Text="Configuración" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
<Grid DockPanel.Dock="Top" Margin="0,0,0,18"><TextBox x:Name="SettingsSearch" Padding="10,7" TextChanged="SettingsSearch_TextChanged" AutomationProperties.Name="Buscar en configuración"/><TextBlock Text="Buscar…" Foreground="#999999" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SettingsSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<Button DockPanel.Dock="Bottom" Content="Cerrar" IsCancel="True" Margin="0,16,0,0"/>
<ListBox x:Name="SettingsNavigation" Background="Transparent" BorderThickness="0" Foreground="#DDDDDD" SelectionChanged="SettingsNavigation_SelectionChanged" HorizontalContentAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="Secciones de configuración">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NavItem" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#303232"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#292B2B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBoxItem Content="General" Tag="general"/><ListBoxItem Content="Capturas" Tag="captures"/><ListBoxItem Content="Galería" Tag="gallery"/><ListBoxItem Content="Nube" Tag="cloud"/><ListBoxItem Content="Formatos" Tag="formats"/><ListBoxItem Content="Cursor" Tag="cursor"/><ListBoxItem Content="Acerca de" Tag="about"/>
</ListBox></DockPanel></Border>
<DockPanel Grid.Column="1" Background="#191A1B">
<TextBlock x:Name="SettingsStatus" DockPanel.Dock="Bottom" Foreground="#FFC0A8" Margin="24,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
<ScrollViewer x:Name="SettingsContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="26,22">
<TextBlock x:Name="SettingsNoResults" Text="No se encontraron opciones." Visibility="Collapsed" Foreground="#BBBBBB"/>
<StackPanel x:Name="GeneralSettings"><TextBlock Text="General" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Inicio y segundo plano" FontWeight="SemiBold" Margin="0,28,0,0"/><Border Style="{StaticResource Card}"><StackPanel>
<CheckBox x:Name="MinimizeAfterCopy" Style="{StaticResource Switch}" Content="Minimizar después de copiar" Click="ToggleSetting_Click"/><TextBlock Text="Minimiza IMG Viewer a la barra de tareas al copiar una imagen o archivos, para pegarlos en otra aplicación. No afecta a la copia automática de capturas." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,42,12"/><Separator/>
<CheckBox x:Name="CloseToTray" Style="{StaticResource Switch}" Content="Ocultar en la bandeja al cerrar" Click="ToggleSetting_Click"/><TextBlock Text="Mantiene disponibles las capturas mientras usas otras aplicaciones." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,42,12"/>
<Separator/><CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}" Content="Iniciar con Windows" Click="ToggleSetting_Click"/><TextBlock Text="Abre IMG Viewer en la bandeja al iniciar sesión." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,42,0"/>
</StackPanel></Border></StackPanel>
<StackPanel x:Name="CaptureSettings" Visibility="Collapsed"><TextBlock Text="Capturas" FontSize="28" FontWeight="SemiBold"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Atajo de captura" FontWeight="SemiBold"/><TextBlock x:Name="CaptureShortcutLabel" Margin="0,10,0,12"/><WrapPanel><Button Content="Cambiar atajo" Click="ChangeCaptureShortcut_Click" Margin="0,0,8,8"/><Button Content="Usar Impr Pant" Click="UsePrintScreen_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="CaptureShortcutStatus" Foreground="#BBBBBB" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="Para usar Impr Pant sola, desactiva su acceso a Recortes en Configuración de Windows > Accesibilidad > Teclado." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><TextBlock Text="Guardado y portapapeles" FontWeight="SemiBold" Margin="0,28,0,0"/><Border Style="{StaticResource Card}"><StackPanel>
<CheckBox x:Name="AutoSaveCaptures" Style="{StaticResource Switch}" Content="Guardar capturas automáticamente" Click="AutoSaveCaptures_Click"/><TextBlock Text="Desactivado: guarda con el icono Guardar o Ctrl + S." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,16"/><Separator Margin="0,0,0,16"/><DockPanel Margin="0,0,0,16"><TextBlock Text="Formato de captura" VerticalAlignment="Center"/><ComboBox x:Name="CaptureFormatPicker" Width="140" HorizontalAlignment="Right" AutomationProperties.Name="Formato de captura"><ComboBoxItem Content="WebP" Tag=".webp"/><ComboBoxItem Content="PNG" Tag=".png"/><ComboBoxItem Content="JPG" Tag=".jpg"/><ComboBoxItem Content="BMP" Tag=".bmp"/></ComboBox></DockPanel><local:WebPOptionsControl Margin="0,0,0,16"><local:WebPOptionsControl.Style><Style TargetType="local:WebPOptionsControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Tag, ElementName=CaptureFormatPicker}" Value=".webp"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:WebPOptionsControl.Style></local:WebPOptionsControl><TextBlock Text="Carpeta de capturas" FontWeight="SemiBold"/><TextBlock Text="Destino de Ctrl + S y del guardado automático. Guardar copia permite elegir otra carpeta." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,6,0,12"/>
<TextBox x:Name="FolderPath" IsReadOnly="True" TextWrapping="Wrap" Padding="8" AutomationProperties.Name="Carpeta actual de capturas"/><WrapPanel Margin="0,12,0,16"><Button Content="Cambiar carpeta" Click="ChangeFolder_Click" Margin="0,0,8,0"/><Button Content="Restablecer a Imágenes" Click="ResetFolder_Click"/></WrapPanel><Separator/>
<CheckBox x:Name="CopyCapturesToClipboard" Style="{StaticResource Switch}" Content="Copiar capturas al portapapeles" Click="ToggleSetting_Click"/><TextBlock Text="Permite pegar la captura directamente en otra aplicación." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,42,0"/>
</StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Después de capturar" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="CaptureResultPicker" SelectionChanged="CaptureResultPicker_SelectionChanged" AutomationProperties.Name="Después de capturar"><ComboBoxItem Content="Mostrar miniatura"/><ComboBoxItem Content="Abrir visor"/></ComboBox><TextBlock Text="Ubicación de la miniatura" Foreground="#AAAAAA" Margin="0,14,0,8"/><ComboBox x:Name="CaptureThumbnailLocation" SelectionChanged="CaptureThumbnailLocation_SelectionChanged" AutomationProperties.Name="Ubicación de la miniatura"><ComboBoxItem Content="Monitor principal"/><ComboBoxItem Content="Monitor de la captura"/></ComboBox><TextBlock Text="Duración de la miniatura (segundos)" Foreground="#AAAAAA" Margin="0,14,0,8"/><ComboBox x:Name="CaptureThumbnailDelay" SelectionChanged="CaptureThumbnailDelay_SelectionChanged" AutomationProperties.Name="Duración de la miniatura"/><TextBlock Text="El tiempo se pausa mientras el cursor está sobre la miniatura. Cerrar conserva la captura como borrador recuperable, también después de reiniciar Windows." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></StackPanel>
<StackPanel x:Name="GallerySettings" Visibility="Collapsed"><TextBlock Text="Galería" FontSize="28" FontWeight="SemiBold"/><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Imágenes por fila" FontWeight="SemiBold"/><TextBlock Text="Cantidad de columnas en la cuadrícula." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><ComboBox x:Name="GridColumnPicker" Grid.Column="1" Width="72" VerticalAlignment="Center" AutomationProperties.Name="Imágenes por fila"/></Grid></Border></StackPanel>
<StackPanel x:Name="FormatSettings" Visibility="Collapsed"><TextBlock Text="Formatos" FontSize="28" FontWeight="SemiBold"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Compresión WebP" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Se aplica al guardar capturas, guardar copias y convertir imágenes, también en lote." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,12"/><local:WebPOptionsControl/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Seleccionar todos" Click="SelectAllFileTypes_Click"/><TextBlock Text="Tipos de archivos" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Elige los formatos que se pueden abrir y mostrar en la galería." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,10,0,12"/><WrapPanel x:Name="FileTypeOptions"/><TextBlock x:Name="FileTypeStatus" Foreground="#FFC0A8" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Visor predeterminado de Windows" FontWeight="SemiBold"/><TextBlock Text="Elige IMG Viewer para abrir imágenes al hacer doble clic. La elección se confirma en Configuración de Windows." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,10,0,14"/><Button Content="Configurar como visor predeterminado" HorizontalAlignment="Left" Click="ConfigureDefaults_Click"/><TextBlock x:Name="DefaultAppsStatus" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border></StackPanel>
<StackPanel x:Name="CursorSettings" Visibility="Collapsed"><TextBlock Text="Cursor" FontSize="28" FontWeight="SemiBold"/><Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="HideIdleCursor" Style="{StaticResource Switch}" Content="Ocultar cursor por inactividad" Click="ToggleSetting_Click"/><TextBlock Text="El cursor vuelve a aparecer al mover el mouse." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,16"/><Separator/>
<Grid Margin="0,16" IsEnabled="{Binding IsChecked, ElementName=HideIdleCursor}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Segundos de espera" VerticalAlignment="Center"/><ComboBox x:Name="CursorDelayPicker" Grid.Column="1" Width="72" AutomationProperties.Name="Segundos de espera del cursor"/></Grid><Separator/>
<Grid Margin="0,16,0,0" IsEnabled="{Binding IsChecked, ElementName=HideIdleCursor}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Alcance" VerticalAlignment="Center"/><ComboBox x:Name="CursorScopePicker" Grid.Column="1" Width="150" AutomationProperties.Name="Alcance del cursor"><ComboBoxItem Content="Solo IMG Viewer"/><ComboBoxItem Content="Todo Windows"/></ComboBox></Grid>
</StackPanel></Border></StackPanel>
<StackPanel x:Name="CloudSettings" Visibility="Collapsed"><TextBlock Text="Nube" FontSize="28" FontWeight="SemiBold"/>
<Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="CloudEnabled" Content="Activar Nube" Style="{StaticResource Switch}"/><TextBlock Text="Muestra la pestaña Nube y las acciones de subida manual. Solo se suben las imágenes que elijas." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,6,0,8"/><CheckBox x:Name="CloudCopyLink" Content="Copiar enlace después de subir" Style="{StaticResource Switch}"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tu conexión con Cloudflare R2" FontWeight="SemiBold"/><TextBlock Text="Usa un token S3 con permisos Object Read &amp; Write limitado a tu bucket. La conexión se guarda protegida para tu usuario de Windows, separada de la publicación de la app." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,8,0,16"/>
<TextBlock Text="Endpoint S3" Margin="0,0,0,5"/><Grid><TextBox x:Name="CloudEndpoint" AutomationProperties.Name="Endpoint S3 de R2" Padding="8" ToolTip="https://ACCOUNT_ID.r2.cloudflarestorage.com"/><TextBlock Text="https://ACCOUNT_ID.r2.cloudflarestorage.com" Foreground="#999999" FontSize="12" Margin="9,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CloudEndpoint}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<TextBlock Text="Bucket" Margin="0,14,0,5"/><Grid><TextBox x:Name="CloudBucket" AutomationProperties.Name="Bucket R2" Padding="8"/><TextBlock Text="mis-imagenes" Foreground="#999999" FontSize="12" Margin="9,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CloudBucket}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<TextBlock Text="Access Key ID" Margin="0,14,0,5"/><Grid><TextBox x:Name="CloudAccess" AutomationProperties.Name="Access Key ID de R2" Padding="8"/><TextBlock Text="Pega tu Access Key ID" Foreground="#999999" FontSize="12" Margin="9,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CloudAccess}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
<TextBlock Text="Secret Access Key" Margin="0,14,0,5"/><Grid><PasswordBox x:Name="CloudSecret" AutomationProperties.Name="Secret Access Key de R2" Padding="8" PasswordChanged="CloudSecret_PasswordChanged"/><TextBlock x:Name="CloudSecretHint" Text="Pega tu Secret Access Key" Foreground="#999999" FontSize="12" Margin="9,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/></Grid>
<TextBlock Text="Carpeta remota" Margin="0,14,0,5"/><Grid><TextBox x:Name="CloudPrefix" AutomationProperties.Name="Carpeta remota de Nube" Padding="8"/><TextBlock Text="img-viewer/images/" Foreground="#999999" FontSize="12" Margin="9,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CloudPrefix}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="Solo se mostrarán y modificarán imágenes dentro de esta carpeta. Usa una carpeta distinta de tus archivos de publicación." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,6,0,0"/>
<TextBlock Text="URL pública del bucket (opcional)" Margin="0,14,0,5"/><Grid><TextBox x:Name="CloudPublicUrl" AutomationProperties.Name="URL pública del bucket R2" Padding="8"/><TextBlock Text="https://imagenes.tudominio.com/" Foreground="#999999" FontSize="12" Margin="9,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CloudPublicUrl}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="Déjala vacía para usar enlaces privados de una hora. Si tu bucket ya tiene un dominio público, introduce su URL raíz para copiar enlaces permanentes. Esta opción no cambia la privacidad del bucket." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,6,0,16"/>
<WrapPanel><Button x:Name="TestCloudButton" Content="Probar conexión" Click="TestCloud_Click" Margin="0,0,8,8"/><Button Content="Guardar conexión" Click="SaveCloud_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="CloudStatus" TextWrapping="Wrap" Foreground="#BBBBBB" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></Border></StackPanel>
<StackPanel x:Name="AboutSettings" Visibility="Collapsed"><TextBlock Text="Acerca de" FontSize="28" FontWeight="SemiBold"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8B9;" FontSize="44" HorizontalAlignment="Center" Margin="0,16,0,20"/><TextBlock Text="IMG Viewer" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="AppVersion" HorizontalAlignment="Center" Margin="0,8,0,18"/><Separator/><TextBlock Margin="0,16,0,0" HorizontalAlignment="Center"><Hyperlink NavigateUri="https://frankgp.com/img-viewer" Foreground="#CCCCCC" RequestNavigate="AppPage_RequestNavigate">frankgp.com/img-viewer</Hyperlink></TextBlock></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel x:Name="UpdateOptions"><TextBlock Text="Actualizaciones" FontWeight="SemiBold"/><TextBlock Text="{Binding EditionLabel}" Foreground="#AAAAAA" Margin="0,6,0,12"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding Notes}" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="0,8,0,8"/><ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Margin="0,4,0,12"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWorking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><WrapPanel><Button Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="UpdateAction_Click" Margin="0,0,8,8"/><Button Content="Cancelar" IsEnabled="{Binding IsWorking}" Click="CancelUpdate_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="UpdateAvailabilityNote" Text="Las actualizaciones se instalan desde el ejecutable single-file publicado; no están activas en Debug ni al ejecutar con dotnet." Foreground="#AAAAAA" TextWrapping="Wrap"/></StackPanel></Border></StackPanel>
</Grid></ScrollViewer></DockPanel></Grid></Window>