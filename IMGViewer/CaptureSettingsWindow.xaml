<Window x:Class="IMGViewer.CaptureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#141820" Foreground="White">
    <StackPanel Margin="18">
        <TextBlock Text="Carpeta de capturas" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBox x:Name="FolderPath" IsReadOnly="True" TextWrapping="Wrap"
                 Padding="8" AutomationProperties.Name="Carpeta actual de capturas" />
        <TextBlock x:Name="SettingsStatus" Foreground="#FFC0A8" TextWrapping="Wrap"
                   Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Margin="0,12,0,0">
            <Button Content="Cambiar carpeta" Click="ChangeFolder_Click" Padding="10,5" Margin="0,0,8,0" />
            <Button Content="Restablecer a Descargas" Click="ResetFolder_Click" Padding="10,5" Margin="0,0,8,0" />
            <Button Content="Cerrar" IsCancel="True" Padding="10,5" />
        </WrapPanel>
    </StackPanel>
</Window>
