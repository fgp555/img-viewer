<UserControl x:Class="IMGViewer.WebPOptionsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="#DDDDDD">
<StackPanel>
<CheckBox x:Name="Lossless" Content="Sin pérdida" Foreground="#EEEEEE" Click="Lossless_Click" Margin="0,0,0,10"/>
<StackPanel x:Name="QualityPanel"><DockPanel><TextBlock x:Name="QualityValue" DockPanel.Dock="Right"/><TextBlock Text="Calidad"/></DockPanel><Slider x:Name="Quality" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="80" Margin="0,8,0,10" ValueChanged="Quality_ValueChanged" AutomationProperties.Name="Calidad WebP"/><TextBlock Text="Menor calidad reduce el peso. 80% ofrece un buen equilibrio para web. 100% sigue usando compresión con pérdida." Foreground="#AAAAAA" TextWrapping="Wrap"/></StackPanel>
<TextBlock x:Name="LosslessHint" Text="Conserva los píxeles de la imagen. Puede generar archivos más grandes." Foreground="#AAAAAA" TextWrapping="Wrap" Visibility="Collapsed"/>
<TextBlock x:Name="Status" Foreground="#FFC0A8" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></UserControl>
