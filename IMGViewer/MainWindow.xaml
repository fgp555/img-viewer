><Button Background="#F24F57" Width="28" Height="28" Padding="0" BorderThickness="0" Margin="0,0,8,4" Tag="#F24F57" Click="MarkerColor_Click" ToolTip="Rojo suave" AutomationProperties.Name="Color Rojo suave"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Swatch" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#B0B0B0" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Swatch" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button><Button Background="#FACC15" Width="28" Height="28" Padding="0" BorderThickness="0" Margin="0,0,8,4" Tag="#FACC15" Click="MarkerColor_Click" ToolTip="Amarillo" AutomationProperties.Name="Color Amarillo"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Swatch" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#B0B0B0" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Swatch" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button><Button Background="#38BDF8" Width="28" Height="28" Padding="0" BorderThickness="0" Margin="0,0,8,4" Tag="#38BDF8" Click="MarkerColor_Click" ToolTip="Azul" AutomationProperties.Name="Color Azul"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Swatch" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#B0B0B0" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Swatch" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button><Button Background="#FFFFFF" Width="28" Height="28" Padding="0" BorderThickness="0" Margin="0,0,8,4" Tag="#FFFFFF" Click="MarkerColor_Click" ToolTip="Blanco" AutomationProperties.Name="Color Blanco"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Swatch" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="#B0B0B0" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Swatch" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Swatch" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button></WrapPanel><TextBlock x:Name="MarkerColorLabel" Visibility="Collapsed"/><StackPanel Margin="0,8,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=TextTool}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><DockPanel Margin="0,8,0,2"><TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=MarkerWidthSlider, StringFormat={}{0:0}%}" Foreground="#D4D4D4"/><TextBlock Text="Grosor" Foreground="#A5A9AB"/></DockPanel><Slider x:Name="MarkerWidthSlider" Style="{StaticResource MarkerSlider}" Minimum="0" Maximum="100" Value="30" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,8" AutomationProperties.Name="Grosor" ToolTip="Grosor"/></StackPanel></StackPanel></StackPanel></StackPanel></ScrollViewer>
        </Border>
    <Grid x:Name="PhotoViewport" Grid.Row="2" Grid.Column="2" Background="{StaticResource ViewerBackground}" ClipToBounds="True" SizeChanged="PhotoViewport_SizeChanged">
        <Image x:Name="Photo" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               MouseLeftButtonDown="Photo_MouseLeftButtonDown" SizeChanged="Photo_SizeChanged">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PhotoZoom" />
                    <TranslateTransform x:Name="PhotoPan" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="MarkerOverlay" Stretch="Uniform" IsHitTestVisible="False"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderTransformOrigin="{Binding RenderTransformOrigin, ElementName=Photo}"
               RenderTransform="{Binding RenderTransform, ElementName=Photo}" />
        <Canvas x:Name="InlineTextCanvas" Width="{Binding ActualWidth, ElementName=Photo}" Height="{Binding ActualHeight, ElementName=Photo}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding RenderTransform, ElementName=Photo}"/>
        <Canvas x:Name="InlineCropCanvas" Background="{x:Null}" Visibility="Collapsed" Panel.ZIndex="5" ClipToBounds="False"/>
        <Canvas IsHitTestVisible="True" Background="{x:Null}"><Thumb x:Name="CurveHandle" Width="14" Height="14" Visibility="Collapsed" Cursor="SizeAll" DragDelta="CurveHandle_DragDelta" ToolTip="Ajustar la curvatura" AutomationProperties.Name="Ajustar la curvatura de la última flecha"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#FFFFFF" Stroke="#168EEA" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Canvas>

        <Canvas IsHitTestVisible="False">
            <Border x:Name="CaptureFrame" Visibility="Collapsed" Opacity="0.85"
                    BorderThickness="2" CornerRadius="3" ClipToBounds="True" SnapsToDevicePixels="True">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFC857" Offset="0" />
                        <GradientStop Color="#FF537F" Offset="0.5" />
                        <GradientStop Color="#A778FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                        Background="#EB171320" CornerRadius="4" Padding="7,3">
                    <TextBlock Text="Captura" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                </Border>
            </Border>
        </Canvas>
        <Canvas IsHitTestVisible="False">
            <Image x:Name="GridOpenImage" Visibility="Collapsed" Stretch="UniformToFill" />
        </Canvas>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Arrastra una imagen aquí" Foreground="White"
                       HorizontalAlignment="Center" FontSize="24" />
            <TextBlock Text="JPG, PNG, BMP, SVG o WebP" Foreground="#CED5E2"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <Grid x:Name="FolderGrid" Visibility="Collapsed" Background="#191B1C">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="GridDragHeader" Height="0" />
            <Grid x:Name="GridScrollArea" Grid.Row="1" Margin="10,0" Background="Transparent"
                  PreviewMouseLeftButtonDown="GridScrollArea_MouseDown" PreviewMouseMove="GridScrollArea_MouseMove"
                  PreviewMouseLeftButtonUp="GridScrollArea_MouseUp" LostMouseCapture="GridScrollArea_LostMouseCapture">
                <ListBox x:Name="GridRows" Background="Transparent"
                         BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="Imágenes de la carpeta" SizeChanged="GridRows_SizeChanged" ScrollViewer.ScrollChanged="GridRows_ScrollChanged">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer x:Name="SquareScroll" CanContentScroll="True" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                          PanningMode="VerticalOnly">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter ContentSource="Content" HorizontalAlignment="Stretch" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                        Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource GridTile}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer x:Name="MasonryScroll" Visibility="Collapsed" Focusable="False"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                              PanningMode="VerticalOnly" SizeChanged="MasonryScroll_SizeChanged"
                              ScrollChanged="MasonryScroll_ScrollChanged">
                    <Canvas x:Name="MasonryCanvas" Height="0" Background="Transparent" />
                </ScrollViewer>
            </Grid>
            <TextBlock x:Name="GridMessage" Grid.Row="1" Foreground="White" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                       IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" />

        </Grid>



    </Grid>
        <Border x:Name="ImageFooter" Grid.Row="3" Grid.ColumnSpan="5" Height="28" Background="#202324" BorderBrush="#34383A" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="MetadataFooter" VerticalAlignment="Center"><TextBlock x:Name="ImageInfo" Foreground="#CCCCCC" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/></Border>
                <TextBlock x:Name="ZoomFooterText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#CCCCCC" FontSize="12" Visibility="Collapsed" ToolTip="Zoom real: 100% equivale a un píxel de imagen por píxel de pantalla" AutomationProperties.Name="Porcentaje de zoom"/><TextBlock x:Name="StatusText" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#CCCCCC" FontSize="12" MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>

                <Button x:Name="CaptureDestinationButton" Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="4,0" Height="24" HorizontalContentAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="CaptureDestination_Click" AutomationProperties.Name="Abrir ubicación de guardado">
                    <TextBlock x:Name="CaptureDestinationText" Foreground="#CCCCCC" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>
        <Border x:Name="GridFooter" Grid.Row="3" Grid.ColumnSpan="5" Height="28" Background="#202324" BorderBrush="#34383A" BorderThickness="0,1,0,0" Padding="10,0" Visibility="Collapsed">
            <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="GridFolderPath" Foreground="#CCCCCC" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="GridSelectionInfo" Grid.Column="1" Margin="16,0,0,0" Foreground="#CCCCCC" FontSize="12" MaxWidth="500" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="{Binding Visibility, ElementName=GridActions}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="GridOperationStatus" Grid.Column="2" Margin="16,0,0,0" Foreground="#CCCCCC" FontSize="12" MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
            </Grid>
        </Border>

    </Grid>
    </Border>
</Window>
