<Window x:Class="IMGViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMG Viewer" Height="450" Width="800" MinWidth="240" MinHeight="160"
        WindowStyle="None" ResizeMode="CanResize"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="ViewerBackground" Color="#141820" />
        <DrawingBrush x:Key="TransparencyBackground"
                      TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"
                      Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#3A3A3A" Geometry="M 0,0 H 24 V 24 H 0 Z" />
                    <GeometryDrawing Brush="#565656" Geometry="M 0,0 H 12 V 12 H 0 Z M 12,12 H 24 V 24 H 12 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>


        <Style x:Key="FloatingButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#DD202632" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF414D60" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#FF414D60" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SavePendingButton" TargetType="Button" BasedOn="{StaticResource FloatingButton}">
            <Setter Property="Background" Value="#FF955300" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFB26500" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource FloatingButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFBD2638" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="PhotoViewport" Background="{StaticResource ViewerBackground}" ClipToBounds="True" SizeChanged="PhotoViewport_SizeChanged">
        <Image x:Name="Photo" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
               MouseLeftButtonDown="Photo_MouseLeftButtonDown">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PhotoZoom" />
                    <TranslateTransform x:Name="PhotoPan" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Arrastra una imagen aquí" Foreground="White"
                       HorizontalAlignment="Center" FontSize="24" />
            <TextBlock Text="JPG, PNG o BMP" Foreground="#CED5E2"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Margin="16,8" Foreground="White" Background="#EF202632"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

        <Button x:Name="SavePendingButton" Style="{StaticResource SavePendingButton}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                Visibility="Collapsed" ToolTip="Rotación sin guardar · Ctrl + S"
                AutomationProperties.Name="Guardar rotación en el archivo original"
                Click="SavePendingButton_Click">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="1.6"
                  StrokeLineJoin="Round"
                  Data="M 2,2 H 13 L 16,5 V 16 H 2 Z M 5,2 V 7 H 12 V 2 M 5,16 V 10 H 13 V 16" />
        </Button>

        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="FloatingControls" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="12,12,12,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Content="✥" Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        Cursor="SizeAll" Focusable="False" ToolTip="Mover ventana"
                        AutomationProperties.Name="Mover ventana"
                        PreviewMouseLeftButtonDown="MoveButton_PreviewMouseLeftButtonDown" />
                <Button x:Name="InfoButton" Content="ⓘ" Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        AutomationProperties.Name="Información de la imagen" PreviewMouseLeftButtonDown="InfoButton_PreviewMouseLeftButtonDown" />
                <Button Content="×" Style="{StaticResource CloseButton}" ToolTip="Cerrar"
                        AutomationProperties.Name="Cerrar ventana" Click="CloseButton_Click" />
            </StackPanel>
            <Border Grid.Row="1" HorizontalAlignment="Right" Margin="12,0,12,12"
                    Padding="12,8" MaxWidth="260" CornerRadius="8" Background="#EF202632">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=InfoButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=InfoButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="ImageInfo" Text="No hay una imagen abierta."
                           Foreground="White" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
