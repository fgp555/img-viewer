<Window x:Class="IMGViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IMG Viewer" Height="450" Width="800" MinWidth="240" MinHeight="160"
        WindowStyle="None" ResizeMode="CanResize"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseWheel="Window_PreviewMouseWheel">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="ActionRed" Color="#FFBD2638" />
        <SolidColorBrush x:Key="ViewerBackground" Color="#141820" />
        <DrawingBrush x:Key="TransparencyBackground"
                      TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"
                      Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#3A3A3A" Geometry="M 0,0 H 24 V 24 H 0 Z" />
                    <GeometryDrawing Brush="#565656" Geometry="M 0,0 H 12 V 12 H 0 Z M 12,12 H 24 V 24 H 12 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>


        <Style x:Key="FloatingButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#DD202632" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#99FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF414D60" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#FF414D60" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Geometry x:Key="PlayIcon">M 4,2 L 15,9 L 4,16 Z</Geometry>
        <Geometry x:Key="PauseIcon">M 6,2 V 16 M 12,2 V 16</Geometry>

        <Style x:Key="FloatingIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <Style x:Key="SavePendingButton" TargetType="Button" BasedOn="{StaticResource FloatingButton}">
            <Setter Property="Background" Value="#FF955300" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFB26500" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource FloatingButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ActionRed}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Geometry x:Key="SquareLayoutIcon">M 1,1 H 7 V 7 H 1 Z M 11,1 H 17 V 7 H 11 Z M 1,11 H 7 V 17 H 1 Z M 11,11 H 17 V 17 H 11 Z</Geometry>
        <Geometry x:Key="MasonryLayoutIcon">M 1,1 H 7 V 10 H 1 Z M 11,1 H 17 V 6 H 11 Z M 1,13 H 7 V 17 H 1 Z M 11,9 H 17 V 17 H 11 Z</Geometry>
        <Geometry x:Key="PhotoViewIcon">M 2,3 H 16 V 15 H 2 Z M 2,13 L 6,9 L 9,12 L 12,8 L 16,12 M 7,6 A 1,1 0 1 1 5,6 A 1,1 0 1 1 7,6 Z</Geometry>
        <DataTemplate x:Key="GridTile">
            <Button ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                    Click="GridPhoto_Click" MouseDoubleClick="GridPhoto_MouseDoubleClick" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Margin="2" BorderThickness="2"
                                BorderBrush="Transparent" Background="#262C36">
                            <Grid ClipToBounds="True">
                                <Image x:Name="Thumbnail" Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                <TextBlock Text="{Binding Name}" Foreground="#D3D9E3" Margin="6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#77ADFF" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#42A5FF" />
                                <Setter TargetName="Tile" Property="BorderThickness" Value="3" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="PhotoViewport" Background="{StaticResource ViewerBackground}" ClipToBounds="True" SizeChanged="PhotoViewport_SizeChanged">
        <Image x:Name="Photo" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               MouseLeftButtonDown="Photo_MouseLeftButtonDown">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PhotoZoom" />
                    <TranslateTransform x:Name="PhotoPan" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
        <Image x:Name="MarkerOverlay" Stretch="{Binding Stretch, ElementName=Photo}" IsHitTestVisible="False"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderTransformOrigin="{Binding RenderTransformOrigin, ElementName=Photo}"
               RenderTransform="{Binding RenderTransform, ElementName=Photo}" />
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Arrastra una imagen aquí" Foreground="White"
                       HorizontalAlignment="Center" FontSize="24" />
            <TextBlock Text="JPG, PNG o BMP" Foreground="#CED5E2"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <Grid x:Name="FolderGrid" Visibility="Collapsed" Background="#141820">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="GridDragHeader" Background="Transparent" MinHeight="54" Padding="0,12,0,6">
                <Border Height="{Binding ActualHeight, ElementName=FloatingControls}" IsHitTestVisible="False" />
            </Border>
            <Grid x:Name="GridScrollArea" Grid.Row="1" Margin="10,0" Background="Transparent"
                  PreviewMouseLeftButtonDown="GridScrollArea_MouseDown" PreviewMouseMove="GridScrollArea_MouseMove"
                  PreviewMouseLeftButtonUp="GridScrollArea_MouseUp" LostMouseCapture="GridScrollArea_LostMouseCapture">
                <ListBox x:Name="GridRows" Background="Transparent"
                         BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.Name="Imágenes de la carpeta" SizeChanged="GridRows_SizeChanged" ScrollViewer.ScrollChanged="GridRows_ScrollChanged">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer x:Name="SquareScroll" CanContentScroll="True" Focusable="False"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                          PanningMode="VerticalOnly">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Focusable" Value="False" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                        Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource GridTile}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer x:Name="MasonryScroll" Visibility="Collapsed" Focusable="False"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                              PanningMode="VerticalOnly" SizeChanged="MasonryScroll_SizeChanged"
                              ScrollChanged="MasonryScroll_ScrollChanged">
                    <Canvas x:Name="MasonryCanvas" Height="0" Background="Transparent" />
                </ScrollViewer>
            </Grid>
            <TextBlock x:Name="GridMessage" Grid.Row="1" Foreground="White" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"
                       IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" />
            <Border Grid.Row="2" Padding="12,5" Background="#202632"
                    BorderBrush="#454C58" BorderThickness="0,1,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GridFolderPath" Foreground="#D3D9E3"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="GridSelectionInfo" Foreground="White" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="64"
                               Visibility="{Binding Visibility, ElementName=GridActions}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="GridOperationStatus" Foreground="White" TextWrapping="Wrap"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>
        <DockPanel x:Name="ImageFooter" VerticalAlignment="Bottom">
            <Border x:Name="MetadataFooter" DockPanel.Dock="Bottom" Visibility="Collapsed"
                    Background="#F2202632" BorderBrush="#686868" BorderThickness="0,1,0,0"
                    Padding="12,8">
                <TextBlock x:Name="ImageInfo" Foreground="White" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Grid>
                <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                           Margin="16,8" Foreground="White" Background="#EF202632"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="12">
                    <Button x:Name="RestorePhotoButton" Style="{StaticResource FloatingButton}" Background="{StaticResource ActionRed}"
                            Visibility="Collapsed" ToolTipService.ShowDuration="5000"
                            AutomationProperties.Name="Restaurar la última imagen enviada a la Papelera"
                            MouseEnter="RestorePhotoButton_MouseEnter" MouseLeave="RestorePhotoButton_MouseLeave"
                            Click="RestorePhotoButton_Click">
                        <Button.ToolTip>
                            <ToolTip Padding="10,6" Content="Restaurar la última imagen · Shift + Supr" />
                        </Button.ToolTip>
                        <Path>
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource FloatingIcon}">
                                    <Setter Property="Data" Value="M 2,5 H 16 M 6,5 V 2 H 12 V 5 M 4,5 L 5,16 H 13 L 14,5 M 7,8 V 13 M 11,8 V 13" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                            <Setter Property="Data" Value="M 7,3 L 2,8 L 7,13 M 2,8 H 11 C 15,8 17,10 17,14 V 16" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <Button x:Name="SavePendingButton" Style="{StaticResource SavePendingButton}"
                            Margin="8,0,0,0"
                            Visibility="Collapsed" ToolTip="Cambios sin guardar · Ctrl + S"
                            AutomationProperties.Name="Guardar cambios en el archivo original"
                            Click="SavePendingButton_Click">
                        <Path Style="{StaticResource FloatingIcon}"
                              Data="M 2,2 H 13 L 16,5 V 16 H 2 Z M 5,2 V 7 H 12 V 2 M 5,16 V 10 H 13 V 16" />
                    </Button>
                </StackPanel>
            </Grid>
        </DockPanel>

        <Grid x:Name="ToolbarArea" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=FolderGrid}" Value="Collapsed">
                            <Setter Property="Background" Value="Transparent" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <WrapPanel x:Name="FloatingControls" Orientation="Horizontal"
                       HorizontalAlignment="Right" Margin="12,12,12,0">
                <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=ToolbarArea}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Visibility, ElementName=MetadataFooter}" Value="Visible">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Visibility, ElementName=FolderGrid}" Value="Visible">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </WrapPanel.Style>
                <StackPanel x:Name="GridActions" Orientation="Horizontal"
                            Margin="0,0,8,0" Visibility="Collapsed">
                    <Button Style="{StaticResource FloatingButton}" Margin="0,0,6,0"
                            ToolTip="Copiar archivos · Ctrl + C" AutomationProperties.Name="Copiar archivos"
                            Click="GridCopy_Click">
                        <Path Style="{StaticResource FloatingIcon}"
                              Data="M 6,6 H 16 V 16 H 6 Z M 2,12 V 2 H 12" />
                    </Button>
                    <Button Style="{StaticResource FloatingButton}" Margin="0,0,6,0"
                            ToolTip="Redimensionar y guardar copias"
                            AutomationProperties.Name="Redimensionar y guardar copias" Click="GridResize_Click">
                        <Path Style="{StaticResource FloatingIcon}"
                              Data="M 7,2 H 2 V 7 M 2,2 L 7,7 M 11,16 H 16 V 11 M 16,16 L 11,11 M 10,2 H 16 V 8 M 2,10 V 16 H 8" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" ToolTip="Enviar a la Papelera · Supr"
                            AutomationProperties.Name="Enviar a la Papelera" Click="GridDelete_Click">
                        <Path Style="{StaticResource FloatingIcon}"
                              Data="M 2,5 H 16 M 6,5 V 2 H 12 V 5 M 4,5 L 5,16 H 13 L 14,5 M 7,8 V 13 M 11,8 V 13" />
                    </Button>
                </StackPanel>
                <Button x:Name="ViewModeButton" Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        ToolTip="Abrir cuadrícula · G" AutomationProperties.Name="Abrir cuadrícula"
                        Click="FolderGridButton_Click">
                    <Path x:Name="ViewModeIcon" Style="{StaticResource FloatingIcon}" Data="{StaticResource SquareLayoutIcon}" />
                </Button>
                <Button x:Name="GridLayoutButton" Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        Visibility="{Binding Visibility, ElementName=FolderGrid}" ToolTip="Cambiar a Masonry"
                        AutomationProperties.Name="Cambiar a Masonry" Click="GridLayoutButton_Click">
                    <Path x:Name="GridLayoutIcon" Style="{StaticResource FloatingIcon}" Data="{StaticResource MasonryLayoutIcon}" />
                </Button>
                <Button x:Name="SlideShowButton" Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        Visibility="Collapsed" ToolTip="Reproducir presentación"
                        AutomationProperties.Name="Reproducir presentación" Click="SlideShowButton_Click">
                    <Path x:Name="SlideShowIcon" Style="{StaticResource FloatingIcon}" Data="{StaticResource PlayIcon}" />
                </Button>
                <Button Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        Cursor="SizeAll" Focusable="False" ToolTip="Mover ventana"
                        AutomationProperties.Name="Mover ventana"
                        PreviewMouseLeftButtonDown="MoveButton_PreviewMouseLeftButtonDown">
                    <Path Style="{StaticResource FloatingIcon}"
                          Data="M 9,1 V 17 M 1,9 H 17 M 6,4 L 9,1 L 12,4 M 6,14 L 9,17 L 12,14 M 4,6 L 1,9 L 4,12 M 14,6 L 17,9 L 14,12" />
                </Button>
                <Button x:Name="CropButton" Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        Visibility="Collapsed" ToolTip="Recortar y enderezar"
                        AutomationProperties.Name="Recortar y enderezar" Click="CropButton_Click">
                    <Path Style="{StaticResource FloatingIcon}"
                          Data="M 5,1 V 13 H 17 M 1,5 H 13 V 17" />
                </Button>
                <Button Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        Visibility="{Binding Visibility, ElementName=CropButton}"
                        ToolTip="Redimensionar imagen" AutomationProperties.Name="Redimensionar imagen"
                        Click="ResizeImageButton_Click">
                    <Path Style="{StaticResource FloatingIcon}"
                          Data="M 7,2 H 2 V 7 M 2,2 L 7,7 M 11,16 H 16 V 11 M 16,16 L 11,11 M 10,2 H 16 V 8 M 2,10 V 16 H 8" />
                </Button>
                <Button x:Name="InfoButton" Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        AutomationProperties.Name="Información de la imagen"
                        ToolTip="Mostrar u ocultar metadatos" Click="InfoButton_Click">
                    <Path Style="{StaticResource FloatingIcon}"
                          Data="M 9,1 A 8,8 0 1 1 9,17 A 8,8 0 1 1 9,1 Z M 9,8 V 13 M 9,5 V 5.3" />
                </Button>
                <Button Style="{StaticResource FloatingButton}" Margin="0,0,8,0"
                        ToolTip="Configuración" AutomationProperties.Name="Configuración"
                        Click="CaptureSettingsButton_Click">
                    <Path Style="{StaticResource FloatingIcon}"
                          Data="M 7,1 H 11 L 12,4 L 14,4 L 16,3 L 18,7 L 16,9 L 16,11 L 18,13 L 16,17 L 13,16 L 12,17 L 11,19 H 7 L 6,17 L 5,16 L 2,17 L 0,13 L 2,11 V 9 L 0,7 L 2,3 L 4,4 H 6 Z M 12,10 A 3,3 0 1 1 6,10 A 3,3 0 1 1 12,10 Z" />
                </Button>
                <Button Style="{StaticResource CloseButton}" ToolTip="Cerrar"
                        AutomationProperties.Name="Cerrar ventana" Click="CloseButton_Click">
                    <Path Style="{StaticResource FloatingIcon}" Width="13" Height="13"
                          Data="M 1,1 L 12,12 M 12,1 L 1,12" />
                </Button>
            </WrapPanel>
        </Grid>
        <Border BorderBrush="#686868" BorderThickness="1"
                IsHitTestVisible="False" SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=(shell:WindowChrome.WindowChrome), RelativeSource={RelativeSource AncestorType=Window}}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</Window>
